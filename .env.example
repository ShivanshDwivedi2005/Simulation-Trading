# Runtime
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# PostgreSQL and Redis
POSTGRES_DB=simulation_trading
POSTGRES_USER=simtrade
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://simtrade:change-me@localhost:5432/simulation_trading
REDIS_URL=redis://localhost:6379/0

# Alpaca. Credentials remain backend-only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_TRADING_REST_URL=https://paper-api.alpaca.markets
ALPACA_DATA_REST_URL=https://data.alpaca.markets
ALPACA_DATA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_DATA_FEED=iex
ALPACA_MAX_STREAM_SYMBOLS=30
ALPACA_ASSET_SYNC_INTERVAL_HOURS=24

# Email OTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SimTrade <no-reply@example.com>
SMTP_USE_TLS=true
OTP_TTL_SECONDS=600
OTP_PEPPER=change-me
ACCESS_TOKEN_TTL_SECONDS=900

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/market
NEXT_PUBLIC_APP_ENV=development
